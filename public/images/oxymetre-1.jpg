<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="400" fill="#f8fafc"/>
  
  <!-- Device Body -->
  <rect x="140" y="120" width="120" height="160" rx="15" fill="#374151"/>
  <rect x="150" y="130" width="100" height="140" rx="10" fill="#1f2937"/>
  
  <!-- Display Screen -->
  <rect x="160" y="150" width="80" height="50" rx="5" fill="#000"/>
  
  <!-- Digital Reading -->
  <text x="200" y="170" text-anchor="middle" fill="#00ff00" font-family="monospace" font-size="16" font-weight="bold">
    98%
  </text>
  <text x="200" y="190" text-anchor="middle" fill="#00ff00" font-family="monospace" font-size="10">
    SpO2
  </text>
  
  <!-- Finger Clip Opening -->
  <rect x="170" y="220" width="60" height="30" rx="15" fill="#00a8b5"/>
  <rect x="175" y="225" width="50" height="20" rx="10" fill="#003d5c"/>
  
  <!-- LED Indicators -->
  <circle cx="185" cy="235" r="3" fill="#dc2626"/>
  <circle cx="215" cy="235" r="3" fill="#16a34a"/>
  
  <!-- Control Button -->
  <circle cx="200" cy="280" r="8" fill="#6b7280"/>
  
  <!-- Finger Illustration -->
  <ellipse cx="200" cy="300" rx="25" ry="8" fill="#fbbf24" opacity="0.3"/>
  <text x="200" y="325" text-anchor="middle" fill="#6b7280" font-family="Arial, sans-serif" font-size="10">
    Placer le doigt ici
  </text>
  
  <!-- Brand Label -->
  <text x="200" y="50" text-anchor="middle" fill="#003d5c" font-family="Arial, sans-serif" font-size="14" font-weight="bold">
    ALTHEA SYSTEMS
  </text>
  
  <!-- Product Label -->
  <text x="200" y="370" text-anchor="middle" fill="#6b7280" font-family="Arial, sans-serif" font-size="12">
    Oxymètre de Pouls
  </text>
</svg>