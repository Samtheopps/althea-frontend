<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="300" fill="#f8fafc"/>
  
  <!-- Gradient overlay -->
  <rect width="400" height="300" fill="url(#sterilisationGradient)" opacity="0.1"/>
  
  <!-- Define gradients -->
  <defs>
    <linearGradient id="sterilisationGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#003d5c;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#00a8b5;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Autoclave -->
  <rect x="120" y="80" width="160" height="80" rx="10" fill="#6b7280"/>
  <rect x="130" y="90" width="140" height="60" rx="8" fill="#374151"/>
  
  <!-- Door -->
  <rect x="130" y="90" width="60" height="60" rx="8" fill="#003d5c"/>
  <circle cx="175" cy="120" r="15" fill="rgba(255,255,255,0.2)"/>
  <circle cx="170" cy="125" r="3" fill="#00a8b5"/>
  
  <!-- Control panel -->
  <rect x="200" y="95" width="60" height="50" rx="5" fill="#1f2937"/>
  <circle cx="220" cy="110" r="4" fill="#16a34a"/>
  <circle cx="240" cy="110" r="4" fill="#dc2626"/>
  <rect x="210" y="125" width="40" height="8" rx="2" fill="#00a8b5"/>
  
  <!-- Steam -->
  <ellipse cx="150" cy="60" rx="8" ry="4" fill="#e5e7eb" opacity="0.7"/>
  <ellipse cx="160" cy="50" rx="6" ry="3" fill="#e5e7eb" opacity="0.5"/>
  <ellipse cx="140" cy="55" rx="5" ry="3" fill="#e5e7eb" opacity="0.6"/>
  
  <!-- Temperature gauge -->
  <circle cx="320" cy="100" r="20" fill="#003d5c"/>
  <circle cx="320" cy="100" r="15" fill="#00a8b5"/>
  <path d="M320 95 L325 100 L320 105" fill="#ffffff" stroke="none"/>
  
  <!-- Decorative elements -->
  <rect x="80" y="170" width="6" height="6" rx="1" fill="#00a8b5" opacity="0.4"/>
  <circle cx="350" cy="140" r="5" fill="#003d5c" opacity="0.3"/>
  
  <!-- Title area -->
  <rect x="50" y="180" width="300" height="80" rx="10" fill="rgba(255,255,255,0.9)"/>
  
  <!-- Title -->
  <text x="200" y="210" text-anchor="middle" fill="#003d5c" font-family="Arial, sans-serif" font-size="24" font-weight="bold">
    STÉRILISATION
  </text>
  
  <!-- Subtitle -->
  <text x="200" y="235" text-anchor="middle" fill="#6b7280" font-family="Arial, sans-serif" font-size="14">
    Autoclaves et équipements de stérilisation
  </text>
  
  <!-- Brand -->
  <text x="200" y="20" text-anchor="middle" fill="#003d5c" font-family="Arial, sans-serif" font-size="12" font-weight="bold">
    ALTHEA SYSTEMS
  </text>
</svg>