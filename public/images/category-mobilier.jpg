<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="300" fill="#f8fafc"/>
  
  <!-- Gradient overlay -->
  <rect width="400" height="300" fill="url(#mobilierGradient)" opacity="0.1"/>
  
  <!-- Define gradients -->
  <defs>
    <linearGradient id="mobilierGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00a8b5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#003d5c;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Medical furniture -->
  <!-- Examination table -->
  <rect x="80" y="120" width="120" height="8" rx="4" fill="#003d5c"/>
  <rect x="90" y="128" width="6" height="30" fill="#6b7280"/>
  <rect x="184" y="128" width="6" height="30" fill="#6b7280"/>
  
  <!-- Medical chair -->
  <ellipse cx="260" cy="110" rx="25" ry="15" fill="#00a8b5" opacity="0.8"/>
  <rect x="250" y="110" width="20" height="40" rx="10" fill="#003d5c"/>
  <ellipse cx="260" cy="160" rx="15" ry="8" fill="#6b7280"/>
  
  <!-- Cabinet -->
  <rect x="300" y="80" width="60" height="80" rx="5" fill="#6b7280" opacity="0.7"/>
  <rect x="310" y="90" width="40" height="30" rx="2" fill="rgba(255,255,255,0.3)"/>
  <rect x="310" y="130" width="40" height="20" rx="2" fill="rgba(255,255,255,0.3)"/>
  <circle cx="345" cy="105" r="2" fill="#003d5c"/>
  <circle cx="345" cy="140" r="2" fill="#003d5c"/>
  
  <!-- Decorative elements -->
  <circle cx="60" cy="80" r="6" fill="#00a8b5" opacity="0.3"/>
  <rect x="340" y="50" width="8" height="8" rx="2" fill="#003d5c" opacity="0.4"/>
  <circle cx="100" cy="200" r="4" fill="#00a8b5" opacity="0.5"/>
  
  <!-- Title area -->
  <rect x="50" y="180" width="300" height="80" rx="10" fill="rgba(255,255,255,0.9)"/>
  
  <!-- Title -->
  <text x="200" y="210" text-anchor="middle" fill="#003d5c" font-family="Arial, sans-serif" font-size="22" font-weight="bold">
    MOBILIER MÉDICAL
  </text>
  
  <!-- Subtitle -->
  <text x="200" y="235" text-anchor="middle" fill="#6b7280" font-family="Arial, sans-serif" font-size="14">
    Tables d'examen, fauteuils médicaux
  </text>
  
  <!-- Brand -->
  <text x="200" y="20" text-anchor="middle" fill="#003d5c" font-family="Arial, sans-serif" font-size="12" font-weight="bold">
    ALTHEA SYSTEMS
  </text>
</svg>