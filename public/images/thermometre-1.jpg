<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="400" fill="#f8fafc"/>
  
  <!-- Thermometer Body -->
  <rect x="180" y="80" width="40" height="200" rx="20" fill="#00a8b5"/>
  
  <!-- Thermometer Bulb -->
  <circle cx="200" cy="320" r="35" fill="#003d5c"/>
  
  <!-- Temperature Scale -->
  <g stroke="#666" stroke-width="2">
    <line x1="140" y1="100" x2="160" y2="100"/>
    <line x1="140" y1="130" x2="150" y2="130"/>
    <line x1="140" y1="160" x2="160" y2="160"/>
    <line x1="140" y1="190" x2="150" y2="190"/>
    <line x1="140" y1="220" x2="160" y2="220"/>
    <line x1="140" y1="250" x2="150" y2="250"/>
  </g>
  
  <!-- Temperature Numbers -->
  <g fill="#374151" font-family="Arial, sans-serif" font-size="12">
    <text x="125" y="105">40°</text>
    <text x="125" y="165">35°</text>
    <text x="125" y="225">30°</text>
  </g>
  
  <!-- Mercury Column -->
  <rect x="185" y="280" width="30" height="35" rx="15" fill="#dc2626"/>
  
  <!-- Brand Label -->
  <text x="200" y="50" text-anchor="middle" fill="#003d5c" font-family="Arial, sans-serif" font-size="14" font-weight="bold">
    ALTHEA SYSTEMS
  </text>
  
  <!-- Product Label -->
  <text x="200" y="370" text-anchor="middle" fill="#6b7280" font-family="Arial, sans-serif" font-size="12">
    Thermomètre Médical
  </text>
</svg>