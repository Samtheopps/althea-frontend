<svg width="400" height="300" viewBox="0 0 400 300" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="400" height="300" fill="#f8fafc"/>
  
  <!-- Gradient overlay -->
  <rect width="400" height="300" fill="url(#diagnosticGradient)" opacity="0.1"/>
  
  <!-- Define gradients -->
  <defs>
    <linearGradient id="diagnosticGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#00a8b5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#003d5c;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Medical instruments -->
  <!-- Stethoscope -->
  <circle cx="150" cy="120" r="25" fill="none" stroke="#00a8b5" stroke-width="4"/>
  <path d="M150 95 Q130 75, 120 60 Q115 55, 120 50" stroke="#00a8b5" stroke-width="3" fill="none"/>
  <path d="M150 95 Q170 75, 180 60 Q185 55, 180 50" stroke="#00a8b5" stroke-width="3" fill="none"/>
  
  <!-- Thermometer -->
  <rect x="220" y="80" width="8" height="60" rx="4" fill="#003d5c"/>
  <circle cx="224" cy="150" r="12" fill="#dc2626"/>
  
  <!-- Blood pressure cuff -->
  <ellipse cx="280" cy="120" rx="30" ry="15" fill="none" stroke="#00a8b5" stroke-width="3"/>
  <rect x="260" y="140" width="40" height="25" rx="3" fill="#003d5c"/>
  
  <!-- Decorative elements -->
  <circle cx="80" cy="200" r="4" fill="#00a8b5" opacity="0.5"/>
  <circle cx="320" cy="80" r="6" fill="#003d5c" opacity="0.3"/>
  <circle cx="350" cy="220" r="8" fill="#00a8b5" opacity="0.2"/>
  
  <!-- Title area -->
  <rect x="50" y="180" width="300" height="80" rx="10" fill="rgba(255,255,255,0.9)"/>
  
  <!-- Title -->
  <text x="200" y="210" text-anchor="middle" fill="#003d5c" font-family="Arial, sans-serif" font-size="24" font-weight="bold">
    DIAGNOSTIC
  </text>
  
  <!-- Subtitle -->
  <text x="200" y="235" text-anchor="middle" fill="#6b7280" font-family="Arial, sans-serif" font-size="14">
    Équipements de diagnostic médical
  </text>
  
  <!-- Brand -->
  <text x="200" y="20" text-anchor="middle" fill="#003d5c" font-family="Arial, sans-serif" font-size="12" font-weight="bold">
    ALTHEA SYSTEMS
  </text>
</svg>